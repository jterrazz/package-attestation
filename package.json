{
    "name": "@jterrazz/attestation",
    "version": "0.3.3",
    "description": "Cryptographic attestation for articles: an EIP-712 signature anchored to Bitcoin through OpenTimestamps.",
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jterrazz/package-attestation.git"
    },
    "bin": {
        "attestation": "./dist/attestation.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": {
            "require": "./dist/index.cjs",
            "import": "./dist/index.js"
        },
        "./browser": {
            "require": "./dist/browser.cjs",
            "import": "./dist/browser.js"
        },
        "./node": {
            "require": "./dist/node.cjs",
            "import": "./dist/node.js"
        }
    },
    "scripts": {
        "build": "typescript build",
        "lint": "typescript check",
        "lint:fix": "typescript fix",
        "test": "vitest --run",
        "test:network": "ATTEST_E2E_NETWORK=1 vitest --run"
    },
    "dependencies": {
        "@noble/hashes": "^2.2.0",
        "open": "^11.0.0",
        "viem": "^2.54.1"
    },
    "devDependencies": {
        "@jterrazz/test": "^18.1.0",
        "@jterrazz/typescript": "^11.3.0",
        "@types/node": "^24.13.2",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24"
    }
}
