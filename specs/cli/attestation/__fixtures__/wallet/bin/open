#!/usr/bin/env node
// outside: stands in for the browser and its wallet on PATH — it reads the typed data the opened page serves, signs it with Hardhat's account, and posts the signature back.
import { hardhatAccount } from '../hardhat.mjs';

const url = process.argv.at(-1);
const page = await (await fetch(url)).text();
const literal = /JSON\.parse\(`([\s\S]*?)`\)/u.exec(page)[1];
const { domain, message, primaryType, types } = JSON.parse(new Function(`return \`${literal}\`;`)());
const { EIP712Domain, ...structs } = types;
const signature = await hardhatAccount.signTypedData({
    domain,
    message: { ...message, claims: { ...message.claims, publishedAt: BigInt(message.claims.publishedAt) } },
    primaryType,
    types: structs,
});
await fetch(new URL('/done', url), { body: JSON.stringify({ signature, signerAddress: hardhatAccount.address }), method: 'POST' });
